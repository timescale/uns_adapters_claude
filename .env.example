# Tiger Cloud service URL.
# After creating a Tiger Cloud service, download the credentials file from the
# console and copy the "Service URL" field here verbatim. It looks like:
#   postgres://tsdbadmin:<password>@<id>.<region>.tsdb.cloud.timescale.com:<port>/tsdb?sslmode=require
# Note: the port is service-specific (NOT 5432), and the host has two subdomain segments.
TIMESCALE_SERVICE_URL=YOUR_TIGER_CLOUD_SERVICE_URL

# MQTT broker — defaults match docker-compose.yml
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883

# Ingester config
INGEST_TOPIC=spBv1.0/#
FLUSH_INTERVAL_SEC=5.0

# Enterprise — constant per adapter, not encoded in the Sparkplug topic
UNS_ENTERPRISE=acme_corp
